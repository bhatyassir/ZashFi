<?xml version="1.0" encoding="utf-8"?>
<!--
  API < 31 Auto Backup rules (companion to data_extraction_rules.xml for API 31+).
  Excludes all app storage domains (files including DataStore Preferences, databases,
  SharedPreferences, root, and external) so router profiles, saved sessions, and
  encrypted secrets never leave the device in cloud backups.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
