<?xml version="1.0" encoding="utf-8"?>
<!--
  M10e widget (developer.android.com/develop/ui/compose/glance/create-app-widget, AppWidgetProviderInfo
  attributes). updatePeriodMillis 0: the system never wakes the app for it; the app pushes updates.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="80dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_router"
    android:previewLayout="@layout/widget_router"
    android:description="@string/widget_description"
    android:widgetCategory="home_screen" />
