<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing from ShaaziFi leaves the phone in a cloud backup or a phone-to-phone transfer.
  android:allowBackup="false" alone does not stop device-to-device transfer on some phones
  (developer.android.com/about/versions/12/behavior-changes-12, Backup and restore).
  Saved passwords are also encrypted with a Keystore key that never leaves the phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
